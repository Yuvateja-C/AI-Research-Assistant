# AI Research Assistant Backend Environment Template

# ── Cloud Database (PostgreSQL - Neon / AWS RDS / Self-hosted) ──
# Omit to fallback to local SQLite database (research_assistant.db)
DATABASE_URL=postgresql://user:password@localhost:5432/research_db

# ── AI Model Provider Keys ──
# Required for primary vector embedding generation & multimodal file parsing
GEMINI_API_KEY=

# OpenRouter (Primary LLM Provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Groq (Fallback LLM Provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Security & Application Configuration ──
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FRONTEND_URL=http://localhost:5173
RESET_DB_ON_STARTUP=false
